@@ -1743,0 +1744,22 @@ class PPOTrainer(ABC):
+        valid_tags = [
+            tag
+            for tag, keep in zip(batch.tags, non_padding_mask, strict=True)
+            if keep
+        ]
+        work_metrics = {}
+        additive_work_fields = (
+            "generated_tokens",
+            "observation_tokens",
+            "search_count",
+            "search_errors",
+            "invalid_actions",
+        )
+        for field in additive_work_fields:
+            values = [tag.get(field) for tag in valid_tags]
+            if values and all(value is not None for value in values):
+                work_metrics[f"work/{field}"] = sum(float(value) for value in values)
+        trajectory_wall = [tag.get("trajectory_wall_seconds") for tag in valid_tags]
+        if trajectory_wall and all(value is not None for value in trajectory_wall):
+            trajectory_wall = np.asarray(trajectory_wall, dtype=float)
+            work_metrics["work/trajectory_wall_seconds_mean"] = trajectory_wall.mean()
+            work_metrics["work/trajectory_wall_seconds_max"] = trajectory_wall.max()
