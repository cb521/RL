index a8ba6ddc645646fdfe7444b2dc2dc7c1d7ca8be9..8b3ae7d3f0387d8fbeef81a5f82ad037063176d8 100644
--- a/slime/ray/train_actor.py
+++ b/slime/ray/train_actor.py
@@ -98,6 +98,20 @@ class TrainRayActor(RayActor):
         clear_memory()
         print_memory("after TrainRayActor.clear_memory")
 
+    def start_nsys_profile(self):
+        """Open the rank-zero NVTX range used for the Nsight capture."""
+        if self.args.debug_rollout_only or self.args.rank != 0:
+            return
+        torch.cuda.synchronize()
+        torch.cuda.nvtx.range_push("search_r1_outer_step")
+
+    def stop_nsys_profile(self):
+        """Synchronize rank-zero work and close its NVTX capture range."""
+        if self.args.debug_rollout_only or self.args.rank != 0:
+            return
+        torch.cuda.synchronize()
+        torch.cuda.nvtx.range_pop()
+
     @abc.abstractmethod
     def sleep(self, tags):
         raise NotImplementedError
