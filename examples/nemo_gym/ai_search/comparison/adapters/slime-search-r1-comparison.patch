diff --git a/slime/ray/train_actor.py b/slime/ray/train_actor.py
index a8ba6ddc645646fdfe7444b2dc2dc7c1d7ca8be9..cd5945db8c63ab6d7e7b154ac9d23c79cd33434a 100644
--- a/slime/ray/train_actor.py
+++ b/slime/ray/train_actor.py
@@ -98,6 +98,20 @@ class TrainRayActor(RayActor):
         clear_memory()
         print_memory("after TrainRayActor.clear_memory")
 
+    def start_nsys_profile(self):
+        """Open the NVTX range used for one process-local Nsight capture."""
+        if self.args.debug_rollout_only:
+            return
+        torch.cuda.synchronize()
+        torch.cuda.nvtx.range_push("search_r1_outer_step")
+
+    def stop_nsys_profile(self):
+        """Synchronize the profiled work and close its NVTX capture range."""
+        if self.args.debug_rollout_only:
+            return
+        torch.cuda.synchronize()
+        torch.cuda.nvtx.range_pop()
+
     @abc.abstractmethod
     def sleep(self, tags):
         raise NotImplementedError
