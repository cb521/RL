diff --git a/slime/ray/actor_group.py b/slime/ray/actor_group.py
index 7662a0de69859290d8cfffd00ac62e61649ebffd..27dd649bc9f3d4277215034720bf14268a65a4ae 100644
--- a/slime/ray/actor_group.py
+++ b/slime/ray/actor_group.py
@@ -210,6 +210,37 @@ class RayTrainGroup:
     def clear_memory(self):
         return ray.get([actor.clear_memory.remote() for actor in self._actor_handlers])
 
+    def start_nsys_profile(self):
+        return ray.get([actor.start_nsys_profile.remote() for actor in self._actor_handlers])
+
+    def stop_nsys_profile(self):
+        # Nsight finalizes an NVTX capture inside range_pop(). Finalizing every
+        # GPU actor at once can deadlock the process-local agents on one node,
+        # so close and materialize the reports one actor at a time.
+        return [ray.get(actor.stop_nsys_profile.remote()) for actor in self._actor_handlers]
+
+    def finalize_nsys_profile(self):
+        """Gracefully exit profiled rank zero, then release the idle peers."""
+        actors, self._actor_handlers = self._actor_handlers, []
+        if not actors:
+            return
+
+        termination_ref = actors[0].__ray_terminate__.remote()
+        ready, unready = ray.wait([termination_ref], num_returns=1, timeout=60)
+        if unready or not ready:
+            raise TimeoutError("Rank-zero graceful profile finalization timed out")
+        try:
+            ray.get(termination_ref)
+        except ray.exceptions.RayActorError:
+            # Ray reports the intentional exit requested by __ray_terminate__
+            # as actor death; other task exceptions must still propagate.
+            pass
+
+        for actor in actors[1:]:
+            ray.kill(actor, no_restart=True)
+        if len(actors) > 1:
+            time.sleep(5)
+
     def set_rollout_manager(self, rollout_manager):
         self._rollout_manager = rollout_manager
         return ray.get([actor.set_rollout_manager.remote(rollout_manager) for actor in self._actor_handlers])
