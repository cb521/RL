diff --git a/benchmark_aligned.sh b/benchmark_aligned.sh
new file mode 100755
index 0000000000000000000000000000000000000000..d167f3e7f75e1655efe30fc0b7432e5856ab7dff
--- /dev/null
+++ b/benchmark_aligned.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+MODEL_NAME="${MODEL_NAME:-Qwen/Qwen2.5-3B-Instruct}"
+DATA_ROOT="${DATA_ROOT:?DATA_ROOT must point to the aligned Parquet fixture}"
+OUTPUT_ROOT="${OUTPUT_ROOT:?OUTPUT_ROOT must be set}"
+NUM_GPUS="${NUM_GPUS:-4}"
+TOTAL_STEPS="${TOTAL_STEPS:-4}"
+PYTHON_BIN="${PYTHON_BIN:-python}"
+# The upstream trainer numbers its first optimizer step as 1 and stops after
+# incrementing the counter. Its stop value is therefore one past the requested
+# number of actual optimizer steps.
+TRAINER_STOP_STEP="$((TOTAL_STEPS + 1))"
+
+mkdir -p "${OUTPUT_ROOT}"
+
+exec "${PYTHON_BIN}" -m verl.trainer.main_ppo \
+  data.train_files="${DATA_ROOT}/train.parquet" \
+  data.val_files="${DATA_ROOT}/validation.parquet" \
+  data.train_data_num=null \
+  data.val_data_num=null \
+  data.train_batch_size=4 \
+  data.val_batch_size=8 \
+  data.max_prompt_length=2048 \
+  data.max_response_length=256 \
+  data.max_start_length=512 \
+  data.max_obs_length=512 \
+  data.shuffle_train_dataloader=false \
+  algorithm.adv_estimator=grpo \
+  actor_rollout_ref.model.path="${MODEL_NAME}" \
+  actor_rollout_ref.model.enable_gradient_checkpointing=false \
+  actor_rollout_ref.model.use_remove_padding=true \
+  actor_rollout_ref.actor.optim.lr=1e-6 \
+  actor_rollout_ref.actor.optim.lr_warmup_steps_ratio=0.0 \
+  actor_rollout_ref.actor.use_kl_loss=true \
+  actor_rollout_ref.actor.ppo_mini_batch_size=16 \
+  actor_rollout_ref.actor.ppo_micro_batch_size=4 \
+  actor_rollout_ref.actor.fsdp_config.param_offload=false \
+  actor_rollout_ref.actor.fsdp_config.grad_offload=false \
+  actor_rollout_ref.actor.fsdp_config.optimizer_offload=false \
+  actor_rollout_ref.rollout.log_prob_micro_batch_size=16 \
+  actor_rollout_ref.rollout.tensor_model_parallel_size=1 \
+  actor_rollout_ref.rollout.name=vllm \
+  actor_rollout_ref.rollout.gpu_memory_utilization=0.5 \
+  actor_rollout_ref.rollout.n_agent=4 \
+  actor_rollout_ref.rollout.temperature=1.0 \
+  actor_rollout_ref.rollout.top_p=0.95 \
+  actor_rollout_ref.ref.log_prob_micro_batch_size=16 \
+  actor_rollout_ref.ref.fsdp_config.param_offload=false \
+  actor_rollout_ref.actor.kl_loss_coef=0.001 \
+  actor_rollout_ref.actor.kl_loss_type=low_var_kl \
+  actor_rollout_ref.actor.state_masking=true \
+  trainer.logger="['console']" \
+  +trainer.val_only=false \
+  +trainer.val_before_train=true \
+  trainer.n_gpus_per_node="${NUM_GPUS}" \
+  trainer.nnodes=1 \
+  trainer.save_freq=4 \
+  trainer.test_freq=-1 \
+  trainer.project_name=aligned-ai-search \
+  trainer.experiment_name=search-r1 \
+  trainer.total_epochs=10 \
+  trainer.total_training_steps="${TRAINER_STOP_STEP}" \
+  trainer.default_hdfs_dir=null \
+  trainer.default_local_dir="${OUTPUT_ROOT}/checkpoints" \
+  max_turns=2 \
+  retriever.url=http://127.0.0.1:8100/retrieve \
+  retriever.topk=3
